{
  "expo": {
    "name": "Finno: Financial Manager",
    "slug": "finno-app",
    "version": "1.0.0",
    "icon": "./src/assets/Finno_icon.png",
    "orientation": "portrait",
    "scheme": "finno",
    "userInterfaceStyle": "automatic",
    "locales": {
      "en": "./locales/default/InfoPlists.strings",
      "pt": "./locales/pt/InfoPlists.strings"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.finno.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "pt"
        ]
      }
    },
    "android": {
      "package": "com.finno.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/Finno_icon.png",
        "backgroundColor": "#18181B"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/Finno_icon_notification.png",
          "color": "#FFFFFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/Finno_icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "pt"
          ]
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "41526d5f-5556-4fe3-b212-ffce2e011fd7"
      }
    }
  }
}
